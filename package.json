{
  "name": "eccentric-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint --fix \"./src/**/*.{ts,tsx}\"",
    "lint:ci": "eslint --fix \"./src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run -u",
    "check:types": "tsc --noEmit",
    "start": "vite-node src/main.tsx",
    "sanity": "pnpm run lint && pnpm run check:types && pnpm run test",
    "build": "esbuild src/main.tsx --bundle --packages=external --minify --platform=node --format=esm --outfile=./dist/index.js"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jiti": "^2.7.0",
    "prettier": "^3.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vite-node": "6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tavily/core": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vxti/typed": "^1.1.0",
    "ai": "^7.0.155",
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.2.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "google-auth-library": "^10.6.2",
    "ink": "^8.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.4",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "ora": "^10.0.0",
    "react": "^19.2.7",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "supports-hyperlinks": "^4.4.0",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.23.0"
}
