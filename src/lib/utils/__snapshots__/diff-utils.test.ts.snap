// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`formatDiffMd > matches its documented envelope shape 1`] = `
"\`\`\`diff
line 1
line 2

---DIFF_SEPARATOR---
line 1
changed

\`\`\`
"
`;

