{
  "mcpServers": {
    "atlassian-jira": {
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ],
      "autoApprove": [
        "getJiraIssue",
        "getJiraProjectIssueTypesMetadata",
        "getIssueLinkTypes",
        "getJiraIssueTypeMetaWithFields",
        "getTransitionsForJiraIssue"
      ]
    },
    "jetbrains": {
      "httpUrl": "http://127.0.0.1:64542/stream",
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "/Users/luca/Projects/Personal/eccentric-agent"
      }
    },
    "github": {
      "disabled": true,
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $GITHUB_PAT"
      },
      "autoApprove": [
        "list_issues"
      ]
    }
  }
}
