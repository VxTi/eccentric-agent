{
  "mcpServers": {
    "atlassian-jira": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ],
      "autoApprove": [
        "getJiraIssue",
        "getJiraProjectIssueTypesMetadata",
        "getIssueLinkTypes",
        "getJiraIssueTypeMetaWithFields",
        "getTransitionsForJiraIssue"
      ]
    },
    "github": {
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $GITHUB_PAT"
      },
      "autoApprove": [
        "list_issues"
      ]
    }
  }
}
